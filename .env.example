# ─── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_ROOT_PASSWORD=localpassword
DATABASE_URL=mongodb://admin:localpassword@localhost:27017/housing_db?authSource=admin

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=localpassword
REDIS_URL=redis://:localpassword@localhost:6379

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Travel Booking APIs (optional — mock data used if empty) ──────────────────
OLA_API_KEY=
UBER_SERVER_TOKEN=
RAPIDO_API_KEY=
RAILYATRI_API_KEY=
IRCTC_RAPIDAPI_KEY=
CONFIRMTKT_API_KEY=
BOOKING_COM_API_KEY=
AGODA_API_KEY=
TRIPADVISOR_API_KEY=

# ── Flight APIs (optional) ────────────────────────────────────────────────────
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
SKYSCANNER_API_KEY=

# ── Payment Gateways (optional) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# ── Email (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── AI Services (optional) ────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
