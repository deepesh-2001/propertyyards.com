{
  "version": 2,
  "name": "auth-service",
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/auth/(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/health",
      "dest": "app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "env": {
    "SERVICE_NAME": "auth-service",
    "SERVICE_PORT": "8001",
    "MONGODB_URL": "@mongodb-atlas-connection-string",
    "REDIS_URL": "@redis-connection-string",
    "JWT_SECRET_KEY": "@jwt-secret-key",
    "JWT_ALGORITHM": "HS256",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "30",
    "REFRESH_TOKEN_EXPIRE_DAYS": "7"
  }
}
