# Database Setup
# MongoDB Atlas Connection String (Vercel Integration)
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/housing_db

# Redis Configuration (Vercel Integration)
REDIS_URL=redis://redis-cluster:6379

# Firecrawl API Key (Vercel Integration)
FIRECRAWL_API_KEY=your-firecrawl-api-key

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_TITLE=Housing Platform API
API_VERSION=1.0.0
API_DESCRIPTION=Real estate management system similar to housing.com
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration
CORS_ORIGINS=["https://propertyyards.com", "http://localhost:5173", "http://localhost:3000", "http://localhost:8080"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# App Configuration
DEBUG=false
ENVIRONMENT=development

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Contact Information
COMPANY_NAME=PropertyYards
CONTACT_PHONE=+1-800-PROPERTY
CONTACT_EMAIL=contact@propertyyards.com
CONTACT_ADDRESS=123 Real Estate Ave
CONTACT_CITY=New York
CONTACT_STATE=NY
CONTACT_ZIP=10001
CONTACT_COUNTRY=USA
CONTACT_WEBSITE=https://propertyyards.com
SUPPORT_HOURS=Mon-Fri 9:00 AM - 6:00 PM EST
EMERGENCY_CONTACT=+1-800-EMERGENCY

# WhatsApp Configuration
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_API_VERSION=v18.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=propertyyards_webhook_token

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@propertyyards.com
EMAIL_FROM_NAME=PropertyYards

# SendGrid Configuration (optional)
SENDGRID_API_KEY=your-sendgrid-api-key

# Mailgun Configuration (optional)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.propertyyards.com

