# Database Setup
# MongoDB Atlas Connection String (Vercel Integration)
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/housing_db

# Redis Configuration (Vercel Integration)
REDIS_URL=redis://redis-cluster:6379

# Firecrawl API Key (Vercel Integration)
FIRECRAWL_API_KEY=your-firecrawl-api-key

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_TITLE=Housing Platform API
API_VERSION=1.0.0
API_DESCRIPTION=Real estate management system similar to housing.com
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration
CORS_ORIGINS=["https://propertyyards.com", "http://localhost:5173", "http://localhost:3000", "http://localhost:8080"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# App Configuration
DEBUG=false
ENVIRONMENT=development

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

